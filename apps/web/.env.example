# Copy to apps/web/.env

# Gemini API key from Google AI Studio (free plan, billing disabled).
GEMINI_API_KEY=

# Optional: comma separated models tried in order. Defaults to gemini-flash-latest,gemini-flash-lite-latest
GEMINI_MODELS=

# Optional: secret that signs the daily AI quota cookie. Defaults to one derived from the API key.
AI_QUOTA_SECRET=
